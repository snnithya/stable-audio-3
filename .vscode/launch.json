{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [

        {
            "name": "Debug debug_dataset.py",
            "type": "python",
            "request": "launch",
            "python": "${command:python.interpreterPath}",
            "program": "${workspaceFolder}/scripts/debug_dataset.py",
            "args": [
                "--config",
                "${workspaceFolder}/stable_audio_3/configs/dataset_configs/preencoded/local_babyslakh_preencoded.json"
            ],
            "envFile": "${workspaceFolder}/.env",
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "Finetune small-music",
            "type": "python",
            "request": "launch",
            "python": "${command:python.interpreterPath}",
            "program": "${workspaceFolder}/scripts/train_finetune.py",
            "args": [
                "--model",
                "small-music-base",
                "--dataset_config",
                "${workspaceFolder}/stable_audio_3/configs/dataset_configs/preencoded/local_babyslakh_streamgen_preencoded.json",
                "--model_config",
                "${workspaceFolder}/stable_audio_3/configs/model_configs/small_music_streamgen.json",
                "--save_dir",
                "/data/scratch-fast/snnithya/sao-3/ft_checkpoints/debug",
            ],
            "envFile": "${workspaceFolder}/.env",
            "console": "integratedTerminal",
            "justMyCode": true,
            "env": {
                "CUDA_VISIBLE_DEVICES": "0"
            }
        },
        {
            // Step through one diffusion-forcing training step. Single process, no logger,
            // batch of 2, so breakpoints in DiffusionCondTrainingWrapper.training_step and
            // DiffusionTransformer._forward are hit immediately.
            "name": "Debug DF training step",
            "type": "python",
            "request": "launch",
            "python": "${command:python.interpreterPath}",
            "program": "${workspaceFolder}/scripts/train_finetune.py",
            "args": [
                "--model",
                "small-music-base",
                "--dataset_config",
                "${workspaceFolder}/stable_audio_3/configs/dataset_configs/preencoded/local_babyslakh_streamgen_preencoded.json",
                "--model_config",
                "${workspaceFolder}/stable_audio_3/configs/model_configs/small_music_base_df.json",
                "--save_dir",
                "/data/scratch-fast/snnithya/sao-3/ft_checkpoints/debug",
                "--steps",
                "5",
                "--batch_size",
                "2",
                "--num_workers",
                "0",
                "--log_every",
                "1",
                "--checkpoint_every",
                "1000",
                "--demo_every",
                "1000",
                "--freeze_conditioner",
                "--logger",
                "none",
                "--name",
                "df-debug"
            ],
            "envFile": "${workspaceFolder}/.env",
            "console": "integratedTerminal",
            "justMyCode": true,
            "env": {
                "CUDA_VISIBLE_DEVICES": "0"
            }
        },
        {
            "name": "lora small-music",
            "type": "python",
            "request": "launch",
            "python": "${command:python.interpreterPath}",
            "program": "${workspaceFolder}/scripts/train_lora.py",
            "args": [
                "--model",
                "small-music-base",
                "--dataset_config",
                "${workspaceFolder}/stable_audio_3/configs/dataset_configs/preencoded/local_babyslakh_streamgen_preencoded.json",
                "--model_config",
                "${workspaceFolder}/stable_audio_3/configs/model_configs/small_music_streamgen.json",
                "--save_dir",
                "/data/scratch-fast/snnithya/sao-3/ft_checkpoints/debug",
            ],
            "envFile": "${workspaceFolder}/.env",
            "console": "integratedTerminal",
            "justMyCode": true,
            "env": {
                "CUDA_VISIBLE_DEVICES": "0"
            }
        },
        {
            "name": "Pre-encode dataset",
            "type": "python",
            "request": "launch",
            "python": "${command:python.interpreterPath}",
            "program": "${workspaceFolder}/scripts/pre_encode_dataset.py",
            "args": [
                "--dataset_config",
                "${workspaceFolder}/stable_audio_3/configs/dataset_configs/dataset2preencoding/local_babyslakh_streamgen.json",
                "--model",
                "same-s",
                "--sample_size",
                "529200",
                "--batch_size",
                "1",
                "--pad"
            ],
            "envFile": "${workspaceFolder}/.env",
            "console": "integratedTerminal",
            "justMyCode": true,
            "env": {
                "CUDA_VISIBLE_DEVICES": "0"
            }
        }
    ]
}